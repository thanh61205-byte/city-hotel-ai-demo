# Copy into Streamlit Community Cloud -> app -> Settings -> Secrets (root-level keys become
# environment variables). Locally: .streamlit/secrets.toml (git-ignored). NEVER commit real values.
# Docs: docs/README_DEPLOY_CLOUD.md

# --- G2 dashboard (existing) ---
G2_TODAY = "2017-05-01"
G2_SEED_HISTORY = "0"          # the history is seeded once before the demo (bootstrap --seed-g2-history)
# Shared G2 action log (direct or SESSION pooler connection, TLS):
G2_DB_URL = "postgresql://g2_app_user:CHANGE_ME@your-host:5432/postgres?sslmode=require"

# --- AI email drafts ---
# Least-privilege role created by the bootstrap (g2_ai_app), TLS required.
G2_AI_DB_URL = "postgresql://g2_ai_app:CHANGE_ME@your-host:5432/postgres?sslmode=require"
G2_AI_WORKSPACE_ID = "g2-demo-20170501"
# n8n Cloud PRODUCTION webhook URLs (after publishing; never /webhook-test/ or localhost)
G2_AI_DRAFT_WEBHOOK_URL = "https://YOUR-TEAM.app.n8n.cloud/webhook/g2-ai-email-draft"
G2_AI_SEND_WEBHOOK_URL = "https://YOUR-TEAM.app.n8n.cloud/webhook/g2-ai-email-send"
# Same value as the n8n "Header Auth" credential (header X-G2-Webhook-Token). Long random string.
G2_AI_WEBHOOK_TOKEN = "CHANGE_ME_LONG_RANDOM"
# Must equal SENDER_REF in n8n/ai_email/build_workflows.py (names the Gmail credential of workflow B)
G2_AI_SENDER_REF = "gmail:g2-team-test-sender"
G2_AI_LIVE_AI = "1"
G2_AI_REAL_EMAIL_ENABLED = "0"  # "1" only after the smoke test; recipients come from the DB allowlist
# Optional minimal gate when the app cannot be private (not a login, not an identity):
# G2_AI_ACCESS_CODE = "CHANGE_ME"
# G2_AI_READ_ONLY = "1"         # public read-only deployment
G2_AI_DRAFT_TIMEOUT_S = "45"
G2_AI_SEND_TIMEOUT_S = "30"
